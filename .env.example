# Database (used by PostgreSQL and the backend)
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=mydatabase

# JWT signing secret (at least 32 characters). Demo value only.
JWT_SECRET=demo-medical-center-jwt-secret-change-me-1234567890

# Email sending (optional): if empty, the app works but sends no emails
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=